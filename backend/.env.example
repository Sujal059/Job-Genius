# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Local MongoDB, or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/job-genius

# ── CORS ──────────────────────────────────────────────────────────────────
# The origin your Vite frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# ── Groq ──────────────────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Used for every structured-JSON call (question generation, grading, skill
# gap analysis). Must support Structured Outputs in `strict: true` mode —
# see https://console.groq.com/docs/structured-outputs for the current
# list of models that do (openai/gpt-oss-120b and openai/gpt-oss-20b as of
# this build).
GROQ_MODEL=openai/gpt-oss-120b

# Used only for the Job Matcher's research step. groq/compound has a
# built-in, server-side web search tool — this is what makes the job
# listings and apply links real instead of simulated.
GROQ_SEARCH_MODEL=groq/compound

# Hard timeouts (ms) before we abort and return a friendly error instead of
# hanging the request. The search model gets longer since web-search calls
# naturally take more time than pure generation.
GROQ_TIMEOUT_MS=30000
GROQ_SEARCH_TIMEOUT_MS=90000

# ── Uploads ───────────────────────────────────────────────────────────────
# Max resume size in bytes (default 8MB)
MAX_RESUME_SIZE_BYTES=8388608

# ── Code execution ("Run" button on coding questions) ───────────────────
# JavaScript always runs client-side (sandboxed Web Worker, no server
# involved). Other languages (Python/Java/C++) need a Piston-compatible
# execution API. Piston's public API (emkc.org) now requires requesting
# access from its maintainer (see README) — self-hosting it yourself via
# Docker is the reliable option: https://github.com/engineer-man/piston
# Leave blank to disable non-JS execution (coding answers are still graded
# by AI either way — this only affects the "Run" preview).
PISTON_API_URL=

# ── Stripe Payment Gateway ──────────────────────────────────────────────
# Enter your Stripe Secret Key (e.g. sk_test_...) and Webhook Secret (whsec_...)
# If left blank, Job Genius seamlessly runs in safe development simulation mode.
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
